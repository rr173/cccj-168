<?xml version="1.0" encoding="utf-8"?>
<!-- same logical catalog as old.xml with DIFFERENT namespace prefixes:
     cat->c, unit->u. Expanded-name matching must produce zero events. -->
<cat:catalog xmlns:cat="urn:catalog" xmlns:unit="urn:units">
  <cat:product cat:sku="P1">
    <cat:name>Alpha</cat:name>
    <cat:price>10.00</cat:price>
    <cat:note>stable note</cat:note>
    <unit:uom>each</unit:uom>
    <cat:variant cat:variantCode="1"><cat:label>red</cat:label><cat:stock>5</cat:stock></cat:variant>
    <cat:variant cat:variantCode="2"><cat:label>blue</cat:label><cat:stock>0</cat:stock></cat:variant>
  </cat:product>
  <cat:product cat:sku="P2">
    <cat:name>Beta</cat:name>
    <cat:price>22.50</cat:price>
